[PrefixDeclaration]
:		http://www.semanticweb.org/exogame/ontologies/2026/4/untitled-ontology-48/
owl:		http://www.w3.org/2002/07/owl#
rdf:		http://www.w3.org/1999/02/22-rdf-syntax-ns#
xml:		http://www.w3.org/XML/1998/namespace
xsd:		http://www.w3.org/2001/XMLSchema#
obda:		https://w3id.org/obda/vocabulary#
rdfs:		http://www.w3.org/2000/01/rdf-schema#

[MappingDeclaration] @collection [[
mappingId	MAPID-970deb5a4c5f44ff917ff62c7f2131e0
target		<http://example.org/movie#Movie/{movie_id}> a <http://example.org/movie#Movie> ; <http://example.org/movie#title> {title} ; <http://example.org/movie#year> {year} . 
source		SELECT movie_id, title, year FROM movie

mappingId	MAPID-2355536ecf9f447ca22437425b4dd508
target		<http://example.org/movie#Movie/{movie_id}> <http://example.org/movie#hasDirector> <http://example.org/movie#Director/{director_id}> . 
source		SELECT movie_id, director_id FROM movie

mappingId	MAPID-e54469a21e604427b558e2637e86897a
target		<http://example.org/movie#Director/{director_id}> a <http://example.org/movie#Director> ; <http://example.org/movie#name> {director_name} . 
source		SELECT director_id, name AS director_name FROM director

mappingId	MAPID-a17cb0c2ee084d67986793b2d120e6bb
target		<http://example.org/movie#Director/{director_id}> <http://example.org/movie#nationality> {director_nationality} . 
source		SELECT director_id, nationality AS director_nationality FROM director

mappingId	MAPID-957f2b267d434a9a9f0b892b6200c7ba
target		<http://example.org/movie#Genre/{genre_id}> a <http://example.org/movie#Genre> ; <http://example.org/movie#genreName> {genre_name} . 
source		SELECT genre_id, genre_name FROM genre

mappingId	MAPID-3e840ae30c8648d096e92d659ce32cbf
target		<http://example.org/movie#Movie/{movie_id}> <http://example.org/movie#hasGenre> <http://example.org/movie#Genre/{genre_id}> . 
source		SELECT movie_id, genre_id FROM movie
]]

