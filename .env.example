# Copy this file to .env and fill in real values. .env is gitignored -- never commit real
# passwords. docker-compose.yml reads these automatically.

POSTGRES_MOVIE_PASSWORD=changeme_movie
POSTGRES_TOURISM_PASSWORD=changeme_tourism

# Phase 4b (recommender candidate generation) -- required for real LLM calls.
# RECOMMENDER_LLM_PROVIDER picks the provider (gemini/openai/azure/mistral/ollama);
# defaults to gemini if unset. Only the API key for the selected provider is required --
# "ollama" needs no key at all, just a running Ollama server (see docker-compose.yml's
# "ollama" service) with the model pulled: `docker exec ollama ollama pull llama3.1:8b`.
RECOMMENDER_LLM_PROVIDER=ollama
RECOMMENDER_LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
