  <http://shaclshapes.org/support> "3"^^xsd:int ;
  <http://www.w3.org/ns/shacl#property> <http://shaclshapes.org/nameAgentShapeProperty> ;
  <http://www.w3.org/ns/shacl#targetClass> dcterms:Agent ;
  <https://www.w3.org/TR/rdf-schema/#ch_comment> "Each http://purl.org/dc/terms/Agent ( ) has at most 1 http://xmlns.com/foaf/0.1/name ( )" .

<http://shaclshapes.org/AnnotationPropertyShape> rdf:type <http://www.w3.org/ns/shacl#NodeShape> ;
